{
  "name": "modulo-classroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "balance": "tsx scripts/classroom-balance.ts",
    "postinstall": "node scripts/copy-vendor.mjs",
    "assets:fetch": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 tsx scripts/fetch-assets.ts",
    "assets:process": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 tsx scripts/process-assets.ts",
    "models:furniture": "blender -b --factory-startup -P tools/blender/furniture.py -- --out public/models/furniture",
    "models:characters": "blender -b --factory-startup -P tools/blender/characters.py -- --out public/models/characters"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
