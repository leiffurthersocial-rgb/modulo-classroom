{
  "name": "modulo-classroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "balance": "tsx scripts/classroom-balance.ts"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
